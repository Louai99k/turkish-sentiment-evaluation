    "adam_epsilon": 1e-8,
    "scheduler": "linear",
    "warmup_steps": 0,
    "classifier": "linear",
    "class_weights_when_used": "N/(3*N_class), computed from training labels only",
    "checkpoint_and_tokenizer_identity": "Use each referenced model configuration's full immutable revisions and declared pooling; no mutable main revision",
