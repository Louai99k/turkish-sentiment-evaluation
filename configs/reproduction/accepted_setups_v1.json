    "distilberturk_standard_ce": {"family": "transformer", "model_config": "configs/models/distilberturk_base_cased_v1.json", "loss": "unweighted", "replication": "five_locked_training_seeds"},
    "convberturk_standard_ce": {"family": "transformer", "model_config": "configs/models/convberturk_base_cased_v1.json", "loss": "unweighted", "replication": "five_locked_training_seeds"}
  },
  "scope_limits": [
    "Fixed reported configurations are provided for new independently identified replications, not automatic reruns or new claims",
