{
  "schema_version": "preprocessing-profile-v1.0",
  "profile_id": "winvoker_canonical_emoji_preserve_v2",
  "description": "Canonical profile changing only emoji-sequence handling: Python re preserves the canonical punctuation target semantics while regex v1 identifies protected Unicode emoji sequences.",
  "behavior": {
    "html": "remove",
    "url": "remove",
    "mention": "remove",
    "punctuation": "remove standalone noise except exclamation and question marks",
    "emoji": "preserve regex-v1 Extended_Pictographic, Emoji_Presentation, regional-indicator, modifier, ZWJ, variation-selector, and keycap sequences",
    "whitespace": "collapse and trim",
    "casing": "preserve"
  },
  "ordered_transformations": [
    {
      "order": 1,
      "operation_id": "coerce_to_string",
      "type": "coerce_to_string"
    },
    {
      "order": 2,
      "operation_id": "strip_outer_whitespace_before_substitution",
      "type": "strip"
    },
    {
      "order": 3,
      "operation_id": "remove_html_tags",
      "type": "regex_substitution",
      "engine": "python_re",
      "pattern": "<[^>]+>",
      "replacement": " "
    },
    {
      "order": 4,
      "operation_id": "remove_urls",
      "type": "regex_substitution",
      "engine": "python_re",
      "pattern": "https?://\\S+|www\\.\\S+",
      "replacement": " "
    },
    {
      "order": 5,
      "operation_id": "remove_mentions",
      "type": "regex_substitution",
      "engine": "python_re",
      "pattern": "(?<!\\w)@\\w+",
      "replacement": " "
    },
    {
      "order": 6,
      "operation_id": "remove_punctuation_while_preserving_emoji_sequences",
      "type": "regex_substitution_preserving_matches",
      "engine": "python_re",
      "protected_engine": "regex_v1",
      "pattern": "(?u)(?<!\\w)[^\\w\\s!?]+(?!\\w)",
      "protected_pattern": "(?V1)(?:[#*0-9]\\uFE0F?\\u20E3|\\p{Regional_Indicator}{2}|(?:\\p{Extended_Pictographic}|\\p{Emoji_Presentation})(?:\\uFE0F|\\p{Emoji_Modifier})?(?:\\u200D(?:\\p{Extended_Pictographic}|\\p{Emoji_Presentation})(?:\\uFE0F|\\p{Emoji_Modifier})?)*)",
      "replacement": " "
    },
    {
      "order": 7,
      "operation_id": "collapse_whitespace",
      "type": "collapse_whitespace",
      "replacement": " "
    },
    {
      "order": 8,
      "operation_id": "strip_outer_whitespace_after_substitution",
      "type": "strip"
    }
  ]
}
